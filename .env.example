# Copy this file to .env  ->  cp .env.example .env   (Windows: copy .env.example .env)
# NEVER commit the .env file.

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave DATABASE_URL out to use SQLite (a file called db.sqlite3) - easiest way to start.
# DATABASE_URL is intentionally unset for local development; Django uses SQLite.

# Email: prints emails in the terminal by default. For real SMTP in production:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Production only
# CSRF_TRUSTED_ORIGINS=https://lms.example.co.za
# ADMINS_EMAILS=lead@example.co.za
